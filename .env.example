# ===================================
# TaskHero — Environment Variables
# Copy to .env and fill in real values
# ===================================

# PostgreSQL
POSTGRES_DB=taskhero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (минимум 32 символа)
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Объектное хранилище (S3-совместимое) — галерея аватаров детей.
# Не самостоятельный MinIO, а внешний провайдер (бюджет RAM на VPS не
# позволяет ещё один контейнер): Яндекс Object Storage / Selectel S3 /
# Cloudflare R2 / AWS S3. Оставь пустыми, если фича аватаров пока не нужна —
# остальное приложение от этого не зависит.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=taskhero-avatars
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Если не задано — собирается из S3_ENDPOINT + S3_BUCKET
S3_PUBLIC_BASE_URL=

# Yandex OAuth2 SSO (регистрация/вход родителей через Яндекс ID)
# Создать приложение: https://oauth.yandex.ru
# Redirect URI: https://<ваш-домен>/login/oauth2/code/yandex
YANDEX_CLIENT_ID=CHANGE_ME
YANDEX_CLIENT_SECRET=CHANGE_ME

# Logging
LOGGING_LEVEL_ROOT=INFO

