<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <!--
        Обновление email мастер-администратора с 'admin' на 'admin@taskhero.local',
        чтобы пройти валидацию @Email на форме логина.
    -->
    <changeSet id="012-fix-admin-email" author="admin">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM users WHERE email = 'admin'
            </sqlCheck>
        </preConditions>

        <update tableName="users">
            <column name="email" value="admin@taskhero.local"/>
            <column name="updated_at" valueComputed="now()"/>
            <where>email = 'admin'</where>
        </update>
    </changeSet>

</databaseChangeLog>
