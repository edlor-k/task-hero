<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-add-preset-group-to-shop" author="task-hero">
        <!-- Группа пресета наград (STUDY, SPORTS, CLEAN, ROUTINE, HOBBY, GAMER) -->
        <addColumn tableName="shop_items">
            <column name="preset_group" type="varchar(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="013-seed-gamer-preset" author="task-hero">
        <!-- Пресет «Геймер»: обновляем существующие маркетплейс-товары -->
        <update tableName="shop_items">
            <column name="preset_group" value="GAMER"/>
            <where>id = 'a1000000-0000-0000-0000-000000000001'</where>
        </update>
        <update tableName="shop_items">
            <column name="preset_group" value="GAMER"/>
            <where>id = 'a1000000-0000-0000-0000-000000000007'</where>
        </update>
        <update tableName="shop_items">
            <column name="preset_group" value="GAMER"/>
            <where>id = 'a1000000-0000-0000-0000-000000000002'</where>
        </update>
        <update tableName="shop_items">
            <column name="preset_group" value="GAMER"/>
            <where>id = 'a1000000-0000-0000-0000-000000000003'</where>
        </update>
        <update tableName="shop_items">
            <column name="preset_group" value="GAMER"/>
            <where>id = 'a1000000-0000-0000-0000-000000000008'</where>
        </update>
    </changeSet>

