    <changeSet id="008-add-marketplace-column" author="task-hero">
        <!-- Добавляем флаг маркетплейса в shop_items -->
        <addColumn tableName="shop_items">
            <column name="is_marketplace" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex tableName="shop_items" indexName="idx_shop_items_marketplace">
            <column name="is_marketplace"/>
        </createIndex>
    </changeSet>

