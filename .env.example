# ===================================
# TaskHero User Service Environment
# Copy this file to .env and configure
# ===================================

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
CONTEXT_PATH=/users

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=taskhero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# JWT (ВАЖНО: Используйте надежный ключ в продакшене!)
JWT_SECRET=your-super-secret-key-min-256-bits-change-this
JWT_EXPIRATION=86400000

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING=WARN

# Liquibase
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false

# JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
